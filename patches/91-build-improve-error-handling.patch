--- a/build/gulpfile.reh.js
+++ b/build/gulpfile.reh.js
@@ -0,0 +1,50 @@
+// Improved error handling for build process
+const gulp = require('gulp');
+const util = require('util');
+
+// Enhanced error reporting
+function handleBuildError(err) {
+  console.error('\x1b[31m%s\x1b[0m', '❌ Build Error:');
+  console.error('Message:', err.message);
+  if (err.stack) {
+    console.error('Stack:', err.stack);
+  }
+  if (err.details) {
+    console.error('Details:', err.details);
+  }
+  process.exit(1);
+}
+
+// Add retry logic for flaky network operations
+async function withRetry(fn, maxRetries = 3, delay = 1000) {
+  let lastError;
+  for (let i = 0; i < maxRetries; i++) {
+    try {
+      return await fn();
+    } catch (err) {
+      lastError = err;
+      if (i < maxRetries - 1) {
+        console.warn(`⚠️  Attempt ${i + 1} failed, retrying in ${delay}ms...`);
+        await new Promise(resolve => setTimeout(resolve, delay));
+        delay *= 2; // Exponential backoff
+      }
+    }
+  }
+  throw lastError;
+}
+
+// Validate build artifacts
+function validateArtifacts(artifacts) {
+  const required = ['vscode-server', 'cli', 'extensions'];
+  const missing = required.filter(r => !artifacts.includes(r));
+  if (missing.length > 0) {
+    throw new Error(`Missing required artifacts: ${missing.join(', ')}`);
+  }
+  console.log('✅ All required artifacts present');
+}
+
+module.exports = {
+  handleBuildError,
+  withRetry,
+  validateArtifacts
+};
