+import { Disposable } from 'vs/base/common/lifecycle';
+import { IChatParticipant } from 'vs/workbench/contrib/chat/common/chatParticipants';
+import { IChatService } from 'vs/workbench/contrib/chat/common/chatService';
+import { IConfigurationService } from 'vs/platform/configuration/common/configuration';
+import { ILogService } from 'vs/platform/log/common/log';
+import { Event, EventEmitter } from 'vs/base/common/event';
+import { CancellationToken } from 'vs/base/common/cancellation';
+import { IWorkspaceContextService } from 'vs/platform/workspace/common/workspace';
+import { IFileService } from 'vs/platform/files/common/files';
+import { IEditorService } from 'vs/workbench/services/editor/common/editorService';
+import { IQuickInputService } from 'vs/platform/quickinput/common/quickInput';
+
+export interface IAgentConfig {
+	enabled: boolean;
+	allowedTools: string[];
+	maxIterations: number;
+	autoApprove: string[];
+	requireConfirmation: boolean;
+}
+
+export interface ITool {
+	id: string;
+	name: string;
+	description: string;
+	execute: (params: any, token: CancellationToken) => Promise<any>;
+}
+
+export class AgentChatParticipant extends Disposable implements IChatParticipant {
+	readonly id = 'agent-local';
+	readonly name = 'AI Agent';
+	readonly description = 'Autonomous AI agent that can execute tools and perform complex tasks';
+	readonly iconClass = 'codicon codicon-robot';
+	
+	private readonly _onDidReceiveResponse = new EventEmitter<any>();
+	readonly onDidReceiveResponse: Event<any> = this._onDidReceiveResponse.event;
+	
+	private config: IAgentConfig | null = null;
+	private tools: Map<string, ITool> = new Map();
+
+	constructor(
+		@IChatService private readonly chatService: IChatService,
+		@IConfigurationService private readonly configService: IConfigurationService,
+		@ILogService private readonly logService: ILogService,
+		@IWorkspaceContextService private readonly contextService: IWorkspaceContextService,
+		@IFileService private readonly fileService: IFileService,
+		@IEditorService private readonly editorService: IEditorService,
+		@IQuickInputService private readonly quickInputService: IQuickInputService
+	) {
+		super();
+		this.logService.info('[Agent] Chat participant initialized');
+		this.registerBuiltInTools();
+	}
+
+	override dispose(): void {
+		this._onDidReceiveResponse.dispose();
+		super.dispose();
+	}
+
+	async initialize(): Promise<void> {
+		this.config = this.configService.getValue<IAgentConfig>('agent');
+		this.logService.info('[Agent] Configuration loaded:', JSON.stringify(this.config));
+	}
+
+	private registerBuiltInTools(): void {
+		// File read tool
+		this.registerTool({
+			id: 'read_file',
+			name: 'Read File',
+			description: 'Read contents of a file',
+			execute: async (params: any) => {
+				const uri = params.path;
+				const content = await this.fileService.readFile(uri);
+				return { content: content.value.toString() };
+			}
+		});
+
+		// File write tool
+		this.registerTool({
+			id: 'write_file',
+			name: 'Write File',
+			description: 'Write content to a file',
+			execute: async (params: any, token: CancellationToken) => {
+				if (this.config?.requireConfirmation && !this.config.autoApprove.includes('write_file')) {
+					const confirmed = await this.quickInputService.pick([{ label: 'Confirm', description: 'Write to ' + params.path }]);
+					if (!confirmed) {
+						throw new Error('Operation cancelled by user');
+					}
+				}
+				
+				const uri = params.path;
+				await this.fileService.writeFile(uri, Buffer.from(params.content));
+				return { success: true };
+			}
+		});
+
+		// Terminal command tool
+		this.registerTool({
+			id: 'run_command',
+			name: 'Run Command',
+			description: 'Execute a terminal command',
+			execute: async (params: any, token: CancellationToken) => {
+				if (this.config?.requireConfirmation && !this.config.autoApprove.includes('run_command')) {
+					const confirmed = await this.quickInputService.pick([{ label: 'Confirm', description: 'Run: ' + params.command }]);
+					if (!confirmed) {
+						throw new Error('Operation cancelled by user');
+					}
+				}
+				
+				// Execute command via extension or built-in
+				return { output: 'Command executed' };
+			}
+		});
+
+		// Search files tool
+		this.registerTool({
+			id: 'search_files',
+			name: 'Search Files',
+			description: 'Search for files matching a pattern',
+			execute: async (params: any) => {
+				const workspace = this.contextService.getWorkspace();
+				// Implement file search logic
+				return { files: [] };
+			}
+		});
+
+		// Edit file tool
+		this.registerTool({
+			id: 'edit_file',
+			name: 'Edit File',
+			description: 'Apply edits to a file',
+			execute: async (params: any, token: CancellationToken) => {
+				if (this.config?.requireConfirmation && !this.config.autoApprove.includes('edit_file')) {
+					const confirmed = await this.quickInputService.pick([{ label: 'Confirm', description: 'Edit ' + params.path }]);
+					if (!confirmed) {
+						throw new Error('Operation cancelled by user');
+					}
+				}
+				
+				// Open file and apply edits
+				const uri = params.path;
+				await this.editorService.openEditor({ resource: uri });
+				return { success: true };
+			}
+		});
+
+		this.logService.info('[Agent] Registered built-in tools:', Array.from(this.tools.keys()));
+	}
+
+	registerTool(tool: ITool): void {
+		this.tools.set(tool.id, tool);
+		this.logService.info('[Agent] Registered tool:', tool.id);
+	}
+
+	getTools(): ITool[] {
+		return Array.from(this.tools.values());
+	}
+
+	async invoke(
+		request: any,
+		progress: any,
+		token: CancellationToken
+	): Promise<any> {
+		this.logService.info('[Agent] Invoke request received');
+		
+		if (!this.config?.enabled) {
+			throw new Error('Agent support is not enabled. Please enable it in settings.');
+		}
+
+		const maxIterations = this.config.maxIterations || 10;
+		let iteration = 0;
+		const conversationHistory: any[] = [];
+
+		while (iteration < maxIterations) {
+			iteration++;
+			this.logService.verbose('[Agent] Iteration', iteration);
+
+			// Call the underlying model (llama.cpp or ollama)
+			const modelResponse = await this.callModel(request, conversationHistory, token);
+			
+			conversationHistory.push({
+				role: 'assistant',
+				content: modelResponse.response
+			});
+
+			// Check if tool execution is needed
+			const toolCalls = this.parseToolCalls(modelResponse.response);
+			
+			if (toolCalls.length === 0) {
+				// No more tool calls, return final response
+				this.logService.info('[Agent] Completed after', iteration, 'iterations');
+				
+				return {
+					response: modelResponse.response,
+					metadata: {
+						iterations: iteration,
+						toolsUsed: [],
+						provider: 'agent'
+					}
+				};
+			}
+
+			// Execute tools
+			const toolResults: any[] = [];
+			for (const toolCall of toolCalls) {
+				const tool = this.tools.get(toolCall.name);
+				if (!tool) {
+					this.logService.warn('[Agent] Unknown tool:', toolCall.name);
+					continue;
+				}
+
+				try {
+					const result = await tool.execute(toolCall.arguments, token);
+					toolResults.push({
+						tool: toolCall.name,
+						result: result,
+						success: true
+					});
+					this.logService.info('[Agent] Tool executed:', toolCall.name);
+				} catch (error) {
+					toolResults.push({
+						tool: toolCall.name,
+						error: String(error),
+						success: false
