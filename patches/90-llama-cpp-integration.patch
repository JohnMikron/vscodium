--- a/src/vs/workbench/contrib/preferences/browser/settings.contribution.ts
+++ b/src/vs/workbench/contrib/preferences/browser/settings.contribution.ts
@@ -0,0 +1,100 @@
+import { registry } from 'vs/platform/registry/common/platform';
+import { Extensions as ConfigurationExtensions } from 'vs/platform/configuration/common/configurationRegistry';
+import { localize } from 'vs/nls';
+
+const configurationRegistry = registry.as(ConfigurationExtensions);
+
+configurationRegistry.registerConfiguration({
+  id: 'llamaCpp',
+  title: localize('llamaCpp.title', 'Llama.cpp Integration'),
+  type: 'object',
+  properties: {
+    'llamaCpp.enabled': {
+      type: 'boolean',
+      default: true,
+      description: localize('llamaCpp.enabled', 'Enable llama.cpp integration for local LLM models')
+    },
+    'llamaCpp.modelPath': {
+      type: 'string',
+      default: '',
+      description: localize('llamaCpp.modelPath', 'Path to the GGUF model file')
+    },
+    'llamaCpp.contextSize': {
+      type: 'integer',
+      default: 65536,
+      minimum: 512,
+      maximum: 262144,
+      description: localize('llamaCpp.contextSize', 'Context size for the model (tokens)')
+    },
+    'llamaCpp.gpuLayers': {
+      type: 'integer',
+      default: 99,
+      minimum: 0,
+      maximum: 999,
+      description: localize('llamaCpp.gpuLayers', 'Number of layers to offload to GPU')
+    },
+    'llamaCpp.threads': {
+      type: 'integer',
+      default: 0,
+      minimum: 0,
+      description: localize('llamaCpp.threads', 'Number of threads (0 = auto-detect)')
+    },
+    'llamaCpp.batchSize': {
+      type: 'integer',
+      default: 512,
+      minimum: 1,
+      description: localize('llamaCpp.batchSize', 'Batch size for prompt processing')
+    },
+    'llamaCpp.enableThinking': {
+      type: 'boolean',
+      default: true,
+      description: localize('llamaCpp.enableThinking', 'Enable thinking/reasoning output display')
+    },
+    'llamaCpp.enableMultimodal': {
+      type: 'boolean',
+      default: true,
+      description: localize('llamaCpp.enableMultimodal', 'Enable multimodal support for vision models')
+    }
+  }
+});
+
+configurationRegistry.registerConfiguration({
+  id: 'offlineMode',
+  title: localize('offlineMode.title', 'Offline Mode'),
+  type: 'object',
+  properties: {
+    'offlineMode.enabled': {
+      type: 'boolean',
+      default: false,
+      description: localize('offlineMode.enabled', 'Enable full offline mode')
+    },
+    'offlineMode.disableExtensions': {
+      type: 'boolean',
+      default: false,
+      description: localize('offlineMode.disableExtensions', 'Disable extension marketplace in offline mode')
+    },
+    'offlineMode.disableGallery': {
+      type: 'boolean',
+      default: false,
+      description: localize('offlineMode.disableGallery', 'Disable extension gallery in offline mode')
+    }
+  }
+});
