+import { Disposable } from 'vs/base/common/lifecycle';
+import { IChatParticipant } from 'vs/workbench/contrib/chat/common/chatParticipants';
+import { IChatService } from 'vs/workbench/contrib/chat/common/chatService';
+import { IConfigurationService } from 'vs/platform/configuration/common/configuration';
+import { ILogService } from 'vs/platform/log/common/log';
+import { Event, EventEmitter } from 'vs/base/common/event';
+import { CancellationToken } from 'vs/base/common/cancellation';
+
+export interface IOllamaConfig {
+	enabled: boolean;
+	baseUrl: string;
+	defaultModel: string;
+	apiKey?: string;
+	timeout: number;
+}
+
+export class OllamaChatParticipant extends Disposable implements IChatParticipant {
+	readonly id = 'ollama-local';
+	readonly name = 'Ollama';
+	readonly description = 'Connect to local or remote Ollama server for LLM inference';
+	readonly iconClass = 'codicon codicon-server';
+	
+	private readonly _onDidReceiveResponse = new EventEmitter<any>();
+	readonly onDidReceiveResponse: Event<any> = this._onDidReceiveResponse.event;
+	
+	private config: IOllamaConfig | null = null;
+
+	constructor(
+		@IChatService private readonly chatService: IChatService,
+		@IConfigurationService private readonly configService: IConfigurationService,
+		@ILogService private readonly logService: ILogService
+	) {
+		super();
+		this.logService.info('[Ollama] Chat participant initialized');
+	}
+
+	override dispose(): void {
+		this._onDidReceiveResponse.dispose();
+		super.dispose();
+	}
+
+	async initialize(): Promise<void> {
+		this.config = this.configService.getValue<IOllamaConfig>('ollama');
+		this.logService.info('[Ollama] Configuration loaded:', JSON.stringify(this.config));
+	}
+
+	async invoke(
+		request: any,
+		progress: any,
+		token: CancellationToken
+	): Promise<any> {
+		this.logService.info('[Ollama] Invoke request received');
+		
+		if (!this.config?.enabled) {
+			throw new Error('Ollama support is not enabled. Please enable it in settings.');
+		}
+
+		const baseUrl = this.config.baseUrl || 'http://localhost:11434';
+		const model = request.model || this.config.defaultModel || 'llama3.2';
+		
+		try {
+			const response = await fetch(`${baseUrl}/api/chat`, {
+				method: 'POST',
+				headers: {
+					'Content-Type': 'application/json',
+					...(this.config.apiKey ? { 'Authorization': `Bearer ${this.config.apiKey}` } : {})
+				},
+				body: JSON.stringify({
+					model: model,
+					messages: request.messages,
+					stream: false,
+					options: {
+						num_predict: request.maxTokens || -1,
+						temperature: request.temperature ?? 0.7,
+						top_p: request.topP ?? 0.9,
+						top_k: request.topK ?? 40,
+						repeat_penalty: request.repeatPenalty ?? 1.1,
+						stop: request.stopSequences || []
+					}
+				}),
+				signal: token ? AbortSignal.timeout(this.config.timeout || 300000) : undefined
+			});
+
+			if (!response.ok) {
+				throw new Error(`Ollama API error: ${response.status} ${response.statusText}`);
+			}
+
+			const data = await response.json();
+			
+			this.logService.info(`[Ollama] Generation complete: ${data.message?.content?.length || 0} chars`);
+
+			return {
+				response: data.message?.content || '',
+				metadata: {
+					model: model,
+					provider: 'ollama',
+					totalDuration: data.total_duration,
+					loadDuration: data.load_duration,
+					promptEvalCount: data.prompt_eval_count,
+					evalCount: data.eval_count
+				}
+			};
+		} catch (error) {
+			this.logService.error('[Ollama] Request failed:', error);
+			throw new Error(`Ollama request failed: ${error}`);
+		}
+	}
+
+	async listModels(): Promise<string[]> {
+		if (!this.config?.enabled) {
+			return [];
+		}
+
+		try {
+			const baseUrl = this.config.baseUrl || 'http://localhost:11434';
+			const response = await fetch(`${baseUrl}/api/tags`);
+			
+			if (!response.ok) {
+				return [];
+			}
+
+			const data = await response.json();
+			return data.models?.map((m: any) => m.name) || [];
+		} catch (error) {
+			this.logService.error('[Ollama] Failed to list models:', error);
+			return [];
+		}
+	}
+}
