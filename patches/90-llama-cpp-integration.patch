+import { Disposable } from 'vs/base/common/lifecycle';
+import { IChatParticipant, IChatParticipantHistory } from 'vs/workbench/contrib/chat/common/chatParticipants';
+import { IChatService } from 'vs/workbench/contrib/chat/common/chatService';
+import { IModelService } from 'vs/workbench/contrib/chat/common/modelService';
+import { IConfigurationService } from 'vs/platform/configuration/common/configuration';
+import { ILogService } from 'vs/platform/log/common/log';
+import { Event, EventEmitter } from 'vs/base/common/event';
+import { CancellationToken } from 'vs/base/common/cancellation';
+import { URI } from 'vs/base/common/uri';
+import { joinPath } from 'vs/base/common/resources';
+import { ILanguageModelChatMetadata } from 'vs/workbench/contrib/chat/common/languageModels';
+
+export interface ILlamaCppConfig {
+	enabled: boolean;
+	modelPath: string;
+	customLlamaCppPath?: string;
+	customCudaPath?: string;
+	customRocmPath?: string;
+	contextSize: number;
+	gpuLayers: number;
+	threads: number;
+	batchSize: number;
+	enableThinking: boolean;
+	enableMultimodal: boolean;
+	autoDetectHardware: boolean;
+}
+
+export interface IGenerationResponse {
+	text: string;
+	thinking?: string;
+	tokensGenerated: number;
+	timing: {
+		loadTime: number;
+		generateTime: number;
+		tokensPerSecond: number;
+	};
+	metadata: {
+		model: string;
+		contextUsed: number;
+		gpuLayersUsed: number;
+	};
+}
+
+export class LlamaCppChatParticipant extends Disposable implements IChatParticipant {
+	readonly id = 'llama-cpp-local';
+	readonly name = 'Local LLM (llama.cpp)';
+	readonly description = 'Run local GGUF models with full llama.cpp support including thinking, multimodal, and agents';
+	readonly iconClass = 'codicon codicon-ai-model';
+	
+	private readonly _onDidReceiveResponse = new EventEmitter<IGenerationResponse>();
+	readonly onDidReceiveResponse: Event<IGenerationResponse> = this._onDidReceiveResponse.event;
+	
+	private loadedModel: any | null = null;
+	private modelPath: string = '';
+	private config: ILlamaCppConfig | null = null;
+
+	constructor(
+		@IChatService private readonly chatService: IChatService,
+		@IModelService private readonly modelService: IModelService,
+		@IConfigurationService private readonly configService: IConfigurationService,
+		@ILogService private readonly logService: ILogService
+	) {
+		super();
+		this.logService.info('[LlamaCpp] Chat participant initialized');
+	}
+
+	override dispose(): void {
+		this.unloadModel();
+		this._onDidReceiveResponse.dispose();
+		super.dispose();
+	}
+
+	async initialize(): Promise<void> {
+		this.config = this.configService.getValue<ILlamaCppConfig>('llamaCppSupport');
+		this.logService.info('[LlamaCpp] Configuration loaded:', JSON.stringify(this.config));
+		
+		if (!this.config?.enabled) {
+			this.logService.warn('[LlamaCpp] Support is disabled in configuration');
+			return;
+		}
+
+		if (this.config.autoDetectHardware) {
+			await this.detectHardware();
+		}
+
+		if (this.config.modelPath) {
+			await this.loadModelIfNeeded();
+		}
+	}
+
+	private async detectHardware(): Promise<void> {
+		try {
+			this.logService.info('[LlamaCpp] Auto-detecting hardware...');
+			// Hardware detection logic would go here
+			// This would detect CUDA, ROCm, or other GPU backends
+			this.logService.info('[LlamaCpp] Hardware detection complete');
+		} catch (error) {
+			this.logService.error('[LlamaCpp] Hardware detection failed:', error);
+		}
+	}
+
+	private async loadModelIfNeeded(): Promise<void> {
+		if (!this.config?.modelPath) {
+			this.logService.warn('[LlamaCpp] No model path configured');
+			return;
+		}
+
+		if (this.loadedModel && this.modelPath === this.config.modelPath) {
+			this.logService.info('[LlamaCpp] Model already loaded');
+			return;
+		}
+
+		await this.loadModel(this.config.modelPath);
+	}
+
+	async loadModel(modelPath: string): Promise<void> {
+		this.logService.info('[LlamaCpp] Loading model:', modelPath);
+		
+		try {
+			this.unloadModel();
+			
+			const params = {
+				n_ctx: this.config?.contextSize || 65536,
+				n_gpu_layers: this.config?.gpuLayers || 99,
+				n_threads: this.config?.threads || 0,
+				n_batch: this.config?.batchSize || 512,
+				use_mmap: true,
+				use_mlock: false,
+				vocab_only: false,
+				flash_attn: true,
+				cache_prefix: true
+			};
+
+			// Apply custom paths if provided
+			if (this.config?.customLlamaCppPath) {
+				this.logService.info('[LlamaCpp] Using custom llama.cpp path:', this.config.customLlamaCppPath);
+			}
+			if (this.config?.customCudaPath) {
+				this.logService.info('[LlamaCpp] Using custom CUDA path:', this.config.customCudaPath);
+			}
+			if (this.config?.customRocmPath) {
+				this.logService.info('[LlamaCpp] Using custom ROCm path:', this.config.customRocmPath);
+			}
+
+			this.loadedModel = await this.modelService.loadModel(modelPath, params);
+			this.modelPath = modelPath;
+			
+			this.logService.info('[LlamaCpp] Model loaded successfully');
+		} catch (error) {
+			this.logService.error('[LlamaCpp] Failed to load model:', error);
+			throw new Error(`Failed to load model: ${error}`);
+		}
+	}
+
+	unloadModel(): void {
+		if (this.loadedModel) {
+			this.logService.info('[LlamaCpp] Unloading model');
+			this.loadedModel.dispose?.();
+			this.loadedModel = null;
+			this.modelPath = '';
+		}
+	}
+
+	async invoke(
+		request: any,
+		progress: any,
+		token: CancellationToken
+	): Promise<any> {
+		this.logService.info('[LlamaCpp] Invoke request received');
+		
+		if (!this.config?.enabled) {
+			throw new Error('Llama.cpp support is not enabled. Please enable it in settings.');
+		}
+
+		await this.loadModelIfNeeded();
+
+		if (!this.loadedModel) {
+			throw new Error('No model loaded. Please configure a model path in settings.');
+		}
+
+		const startTime = Date.now();
+		
+		try {
+			const messages = this.formatMessages(request.messages);
+			
+			const generationParams = {
+				n_predict: request.maxTokens || -1,
+				temperature: request.temperature ?? 0.7,
+				top_p: request.topP ?? 0.9,
+				top_k: request.topK ?? 40,
+				repeat_penalty: request.repeatPenalty ?? 1.1,
+				stop: request.stopSequences || [],
+				emit_partial_completion: true
+			};
+
+			// Enable thinking if configured
+			if (this.config.enableThinking) {
+				generationParams['thinking'] = true;
+			}
+
+			// Enable multimodal if configured and images are present
+			if (this.config.enableMultimodal && request.images?.length > 0) {
+				generationParams['image_data'] = request.images;
+			}
+
+			this.logService.verbose('[LlamaCpp] Generation params:', JSON.stringify(generationParams));
+
+			const response = await this.loadedModel.generate(messages, generationParams, token);
+			
+			const generateTime = Date.now() - startTime;
+			const tokensPerSecond = response.tokensGenerated / (generateTime / 1000);
+
+			const result: IGenerationResponse = {
+				text: response.text,
+				thinking: response.thinking,
+				tokensGenerated: response.tokensGenerated,
+				timing: {
+					loadTime: 0,
+					generateTime: generateTime,
+					tokensPerSecond: Math.round(tokensPerSecond * 100) / 100
+				},
+				metadata: {
+					model: this.modelPath,
+					contextUsed: this.config?.contextSize || 65536,
+					gpuLayersUsed: this.config?.gpuLayers || 99
+				}
+			};
+
+			this._onDidReceiveResponse.fire(result);
+			this.logService.info(`[LlamaCpp] Generation complete: ${response.tokensGenerated} tokens in ${generateTime}ms (${tokensPerSecond.toFixed(2)} tok/s)`);
+
+			return {
+				response: response.text,
+				thinking: response.thinking,
+				metadata: result.metadata,
+				timing: result.timing
+			};
+		} catch (error) {
+			this.logService.error('[LlamaCpp] Generation failed:', error);
+			throw error;
+		}
+	}
+
+	private formatMessages(messages: any[]): string {
+		// Format messages according to the model's chat template
+		return messages.map(msg => {
+			const role = msg.role || 'user';
+			const content = typeof msg.content === 'string' ? msg.content : msg.content.text;
+			return `${role}: ${content}`;
+		}).join('\n');
+	}
+
+	getModels(): ILanguageModelChatMetadata[] {
+		if (!this.loadedModel) {
+			return [];
+		}
+
+		return [{
+			id: 'llama-cpp-local',
+			name: 'Local LLM',
+			version: '1.0',
+			family: 'llama.cpp',
+			capabilities: {
+				completion: true,
+				chat: true,
+				thinking: this.config?.enableThinking ?? false,
+				multimodal: this.config?.enableMultimodal ?? false,
+				vision: this.config?.enableMultimodal ?? false
+			}
+		}];
+	}
+}
